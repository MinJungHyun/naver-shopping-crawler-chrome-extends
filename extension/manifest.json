{
  "manifest_version": 3,
  "name": "네이버 쇼핑 수집기",
  "version": "0.7.1",
  "description": "검색어 배열과 탐색·대기 설정으로 네이버 쇼핑 상품 정보를 로컬에 수집합니다.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "unlimitedStorage", "scripting", "activeTab"],
  "host_permissions": ["https://search.shopping.naver.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "네이버 쇼핑 수집기 레이어 열기/닫기" },
  "web_accessible_resources": [{
    "resources": ["dashboard.html"],
    "matches": ["https://*/*", "http://*/*"]
  }],
  "content_scripts": [{
    "matches": ["https://search.shopping.naver.com/*"],
    "js": ["core.js", "extractor.js", "content.js"],
    "run_at": "document_idle"
  }]
}
