{
  "manifest_version": 3,
  "name": "네이버 쇼핑 수집기",
  "version": "0.1.0",
  "description": "검색어 배열로 네이버 쇼핑 1~2페이지의 상품 정보를 로컬에 수집합니다.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "unlimitedStorage"],
  "host_permissions": ["https://search.shopping.naver.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "네이버 쇼핑 수집기 열기" },
  "content_scripts": [{
    "matches": ["https://search.shopping.naver.com/*"],
    "js": ["core.js", "extractor.js", "content.js"],
    "run_at": "document_idle"
  }]
}
